# Скопируйте этот файл на сервере в .env (рядом с docker-compose.yml) и
# заполните реальными значениями. .env в git не попадает.

NODE_ENV=production
PORT=3001

# --- Postgres (используется контейнером postgres и DATABASE_URL ниже) ---
POSTGRES_USER=perekusov
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=perekusy

# Хост "postgres" — это имя сервиса БД в docker-compose, а не localhost
DATABASE_URL=postgresql://perekusov:CHANGE_ME_STRONG_PASSWORD@postgres:5432/perekusy

# Сгенерировать: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

GOOGLE_CLIENT_ID=
GEMINI_API_KEY=

VISION_OPENROUTER_API_KEY=
VISION_OPENROUTER_API_URL=https://openrouter.ai/api/v1
VISION_OPENROUTER_MODEL=

RECOMMENDATION_OPENROUTER_API_KEY=
RECOMMENDATION_OPENROUTER_API_URL=https://openrouter.ai/api/v1
RECOMMENDATION_OPENROUTER_MODEL=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=твой_аккаунт@gmail.com
SMTP_PASS=шестнадцатьсимволовбезпробелов
SMTP_FROM=Дневник Питания <твой_аккаунт@gmail.com>
