// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

///////
/////   ENUMS
///////

// Роли пользователей
enum Role {
  USER         @map("user")
  NUTRITIONIST @map("nutritionist")
  ADMIN        @map("admin")

  @@map("roles")
}

enum ActivityLevel {
  SEDENTARY @map("sedentary")
  LIGHT     @map("light")
  MODERATE  @map("moderate")
  ACTIVE    @map("active")
  EXTRA     @map("extra")

  @@map("activity_levels")
}

enum GroupRole {
  OWNER  @map("owner")
  ADMIN  @map("admin")
  MEMBER @map("member")

  @@map("group_roles")
}

enum ChatType {
  PRIVATE      @map("private")
  FAMILY       @map("family")
  CONSULTATION @map("consultation")

  @@map("chat_types")
}

enum ChatRole {
  ADMIN  @map("admin")
  MEMBER @map("member")

  @@map("chat_roles")
}

// Источники данных о продуктах
enum ProductSource {
  MANUAL          @map("manual")
  AI              @map("ai")
  EXTERNAL_SOURCE @map("external")
  VERIFIED        @map("verified")

  @@map("product_sources")
}

enum SeverityLevel {
  LOW    @map("low")
  MEDIUM @map("medium")
  HIGH   @map("high")

  @@map("severity_levels")
}

// Статусы подписок
enum SubscriptionStatus {
  ACTIVE    @map("active")
  EXPIRED   @map("expired")
  PENDING   @map("pending")
  CANCELLED @map("cancelled")

  @@map("subscription_statuses")
}

enum PaymentStatus {
  PENDING   @map("pending")
  COMPLETED @map("completed")
  FAILED    @map("failed")
  CANCELLED @map("cancelled")
  REFUNDED  @map("refunded")

  @@map("payment_status")
}

enum BillingInterval {
  MONTH @map("month")
  YEAR  @map("year")

  @@map("billing_intervals")
}

enum Gender {
  MALE   @map("male")
  FEMALE @map("female")

  @@map("genders")
}

enum ProductVisibility {
  PRIVATE @map("private") // только владелец
  SHARED  @map("shared") // расшарен другим пользователям
  PUBLIC  @map("public") // системный (без владельца)

  @@map("product_visibility")
}

enum InvitationStatus {
  PENDING  @map("pending")
  ACCEPTED @map("accepted")
  DECLINED @map("declined")
  EXPIRED  @map("expired")

  @@map("invitation_status")
}

///////
/////   MODELS
///////

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh-tokens")
}

model EmailVerificationCode {
  id        String   @id @default(uuid())
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email-verification-codes")
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  passwordHash  String        @map("password_hash")
  username      String        @unique
  gender        Gender?
  birthDate     DateTime?     @map("birth_date")
  heightCm      Float?        @map("height_in_cm")
  currentWeight Float?        @map("current_weight")
  activityLevel ActivityLevel @default(MODERATE) @map("activity_level")
  createdAt     DateTime      @default(now()) @map("created_at")
  deletedAt     DateTime?
  emailVerified Boolean       @default(false) @map("email_verified")

  // Отношения
  userRoles                     UserRole[]
  meals                         Meal[]
  reactions                     Reaction[]
  groupMemberships              FamilyGroupMember[]
  messages                      Message[]
  recommendation                Recommendation[]
  chatMembers                   ChatMember[]
  achievements                  Achievement[]
  weightHistory                 WeightHistory[]
  refreshToken                  RefreshToken[]
  emailVerificationCodes        EmailVerificationCode[]
  products                      Product[]
  productStats                  ProductReactionStat[]
  productDetails                ProductReactionDetail[]
  sendedFamilyGroupInvitation   FamilyGroupInvitation[] @relation("SentInvitations")
  receivecFamilyGroupInvitation FamilyGroupInvitation[] @relation("ReceivedInvitations")

  @@map("users")
}

model UserRole {
  userId String @map("user_id")
  role   Role   @default(USER)

  user User @relation(fields: [userId], references: [id])

  @@id([userId, role])
  @@map("user_roles")
}

model Product {
  id   String @id @default(uuid())
  name String

  calories Float @default(0)
  proteins Float @default(0)
  fats     Float @default(0)
  carbs    Float @default(0)

  source     ProductSource     @default(MANUAL)
  visibility ProductVisibility @default(PRIVATE)

  ownerId String? @map("owner_id")

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  owner                  User?                   @relation(fields: [ownerId], references: [id])
  mealItems              MealItem[]
  productReactionStats   ProductReactionStat[]
  productReactionDetails ProductReactionDetail[]

  @@index([name])
  @@index([ownerId, visibility])
  @@index([deletedAt])
  @@map("products")
}

model Meal {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  timestamp DateTime @default(now())
  photoUrl  String?  @map("photo_url")

  // Отношения
  user          User           @relation(fields: [userId], references: [id])
  items         MealItem[]
  mealReactions MealReaction[]

  @@index([userId, timestamp])
  @@map("meals")
}

model MealItem {
  id        String @id @default(uuid())
  mealId    String @map("meal_id")
  productId String @map("product_id")
  weightG   Float  @map("weight_in_grams")

  meal    Meal    @relation(fields: [mealId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([mealId, productId])
  @@map("meal_items")
}

model Reaction {
  id          String  @id @default(uuid())
  userId      String  @map("user_id")
  name        String
  description String?

  user                   User                    @relation(fields: [userId], references: [id])
  mealReactions          MealReaction[]
  productReactionDetails ProductReactionDetail[]

  @@index([userId])
  @@map("reactions")
}

model MealReaction {
  id             String         @id @default(uuid())
  mealId         String         @map("meal_id")
  userReactionId String         @map("user_reaction_id")
  severity       SeverityLevel?
  meal           Meal           @relation(fields: [mealId], references: [id])
  reaction       Reaction       @relation(fields: [userReactionId], references: [id])

  @@unique([mealId, userReactionId])
  @@index([mealId])
  @@index([userReactionId])
  @@map("meal_reactions")
}

model Recommendation {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  // authorId  Int?     @map("author_id") // Эксперт или NULL для ИИ [cite: 973]
  // author    User?    @relation("AuthoredRecommendations", fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("recommendations")
}

model FamilyGroup {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  chatId    String   @unique @map("chat_id")

  members     FamilyGroupMember[]
  invitations FamilyGroupInvitation[]

  chat Chat @relation(fields: [chatId], references: [id])

  @@map("family_groups")
}

model FamilyGroupMember {
  userId     String    @id @map("user_id")
  groupId    String    @map("group_id")
  role       GroupRole @default(MEMBER)
  created_at DateTime  @default(now())

  user  User        @relation(fields: [userId], references: [id])
  group FamilyGroup @relation(fields: [groupId], references: [id])

  @@index([groupId])
  @@map("family_members")
}

model FamilyGroupInvitation {
  id        String           @id @default(uuid())
  token     String           @unique
  status    InvitationStatus @default(PENDING)
  expiresAt DateTime         @map("expires_at")
  createdAt DateTime         @default(now()) @map("created_at")

  groupId String      @map("group_id")
  group   FamilyGroup @relation(fields: [groupId], references: [id])

  invitedById String @map("invited_by_id")
  invitedBy   User   @relation("SentInvitations", fields: [invitedById], references: [id])

  invitedUserId String? @map("invited_user_id")
  invitedUser   User?   @relation("ReceivedInvitations", fields: [invitedUserId], references: [id])

  @@index([groupId])
  @@map("family_group_invitations")
}

model Chat {
  id   String   @id @default(uuid())
  name String?
  type ChatType

  messages    Message[]
  familyGroup FamilyGroup?
  chatMembers ChatMember[]

  @@map("chats")
}

model ChatMember {
  chatId String   @map("chat_id")
  userId String   @map("user_id")
  role   ChatRole @default(MEMBER)

  chat Chat @relation(fields: [chatId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@id([chatId, userId])
  @@index([userId])
  @@map("chat_members")
}

model Message {
  id        String    @id @default(uuid())
  chatId    String    @map("chat_id")
  senderId  String    @map("sender_id")
  content   String
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  chat   Chat @relation(fields: [chatId], references: [id])
  sender User @relation(fields: [senderId], references: [id])

  @@index([chatId, createdAt])
  @@index([senderId])
  @@map("messages")
}

model Achievement {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  type        String
  date        DateTime @default(now())
  description String

  user User @relation(fields: [userId], references: [id])

  @@index([userId, date])
  @@index([type])
  @@map("achievements")
}

model WeightHistory {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  weightInKg Float    @map("weight_in_kg")
  measuredAt DateTime @default(now()) @map("measured_at") @db.Date

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, measuredAt])
  @@index([userId, measuredAt(sort: Desc)])
  @@map("weight_history")
}

// ProductReactions types
model ProductReactionStat {
  id        String @id @default(uuid())
  userId    String
  productId String

  // базовая статистика
  mealsCount         Int      @default(0)
  reactionMealsCount Int      @default(0)
  updatedAt          DateTime @updatedAt

  // связи
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model ProductReactionDetail {
  id String @id @default(uuid())

  userId     String
  productId  String
  reactionId String

  // сколько раз эта реакция была с этим продуктом
  count Int @default(0)

  // сумма сил реакций
  severitySum Float    @default(0)
  updatedAt   DateTime @updatedAt

  // связи
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  reaction Reaction @relation(fields: [reactionId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, reactionId])
  @@index([userId, productId])
  @@index([userId, reactionId])
  @@index([productId])
}
